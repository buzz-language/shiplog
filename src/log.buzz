namespace shiplog\log;

import "buzz:std";
import "buzz:io";
import "pkg:shiplog/term" as _;

export enum Level {
    Debug,
    Info,
    Warning,
    Error,
}

export object Logger {
    static instance: Logger?;

    into: io\File,
    level: Level,

    fun log(message: str, scope: str? = null, level: Level) > void {
        if (level.value < this.level.value) {
            return;
        }

        try {
            if (scope -> space) {
                this.into.write("[{space}] ");
            }

            if (this.into.isTTY()) {
                match (level) {
                    .Debug -> this.into.write(blue("Debug")),
                    .Info -> this.into.write(green("Info")),
                    .Warning -> this.into.write(yellow("Warning")),
                    .Error -> this.into.write(red("Error")),
                }
            } else {
                if (level == Level.Debug) {
                    this.into.write("Debug");
                } else if (level == Level.Info) {
                    this.into.write("Info");
                } else if (level == Level.Warning) {
                    this.into.write("Warning");
                } else if (level == Level.Error) {
                    this.into.write("Error");
                }
            }

            this.into.write(": {message}\n");
        } catch {
            std\print("{message}");
        }
    }

    fun debug(message: str, scope: str? = null) > void {
        this.log(message, scope, level: .Debug);
    }

    fun info(message: str, scope: str? = null) > void {
        this.log(message, scope, level: .Info);
    }

    fun warning(message: str, scope: str? = null) > void {
        this.log(message, scope, level: .Warning);
    }

    fun error(message: str, scope: str? = null) > void {
        this.log(message, scope, level: .Error);
    }
}

test "logger" {
    Logger.instance = .{
        into = io\stdout,
        level = Level.Debug,
    };

    Logger.instance?.debug("hello world", scope: "DEV");
    Logger.instance?.info("hello world", scope: "DEV");
    Logger.instance?.warning("hello world", scope: "DEV");
    Logger.instance?.error("hello world", scope: "DEV");
}
