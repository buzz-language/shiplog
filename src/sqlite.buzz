namespace shiplog\sqlite;

import "buzz:ffi";
import "buzz:std";
import "buzz:buffer";
import "buzz:serialize" as _;
import "buzz:errors";

zdef(
    "sqlite3",
    `
    fn sqlite3_initialize() c_int;
    fn sqlite3_shutdown() c_int;
    // Right now we can't express a ptr to an opaque struct because we need to know its size
    fn sqlite3_open_v2(filename: [*:0]const u8, ppDb: **anyopaque, flags: c_int, zVfs: ?[*:0]const u8) c_int;
    fn sqlite3_close_v2(db: *anyopaque) c_int;
    fn sqlite3_errmsg(db: *anyopaque) [*:0]const u8;
    fn sqlite3_prepare_v2(db: *anyopaque, zSql: [*:0]const u8, nBytes: c_int, ppStmt: **anyopaque, pzTail: ?*[*]const u8) c_int;
    fn sqlite3_finalize(pStmt: *anyopaque) c_int;
    fn sqlite3_step(pStmt: *anyopaque) c_int;
    fn sqlite3_column_count(pStmt: *anyopaque) c_int;
    fn sqlite3_column_type(pStmt: *anyopaque, col: c_int) c_int;
    fn sqlite3_column_blob(pStmt: *anyopaque, col: c_int) *anyopaque;
    fn sqlite3_column_double(pStmt: *anyopaque, col: c_int) f64;
    fn sqlite3_column_int(pStmt: *anyopaque, col: c_int) c_int;
    fn sqlite3_column_int64(pStmt: *anyopaque, col: c_int) i64;
    fn sqlite3_column_text(pStmt: *anyopaque, col: c_int) [*:0]const u8;
    fn sqlite3_mprintf(str: [*:0]const u8) ?[*:0]const u8;
`
);

enum<int> ResultCode {
    Ok = 0, // Successful result
    Error = 1, // Generic error
    Internal = 2, // Internal logic error in SQLite
    Perm = 3, // Access permission denied
    Abort = 4, // Callback routine requested an abort
    Busy = 5, // The database file is locked
    Locked = 6, // A table in the database is locked
    NoMem = 7, // A malloc() failed
    Readonly = 8, // Attempt to write a readonly database
    Interrupt = 9, // Operation terminated by sqlite3_interrupt(
    IoErr = 10, // Some kind of disk I/O error occurred
    Corrupt = 11, // The database disk image is malformed
    NotFound = 12, // Unknown opcode in sqlite3_file_control()
    Full = 13, // Insertion failed because database is full
    CantOpen = 14, // Unable to open the database file
    Protocol = 15, // Database lock protocol error
    Empty = 16, // Internal use only
    Schema = 17, // The database schema changed
    TooBig = 18, // String or BLOB exceeds size limit
    Constraint = 19, // Abort due to constraint violation
    Mismatch = 20, // Data type mismatch
    Misuse = 21, // Library used incorrectly
    NoLfs = 22, // Uses OS features not supported on host
    Auth = 23, // Authorization denied
    Format = 24, // Not used
    Range = 25, // 2nd parameter to sqlite3_bind out of range
    NotADB = 26, // File opened that is not a database file
    Notice = 27, // Notifications from sqlite3_log()
    Warning = 28, // Warnings from sqlite3_log()
    Row = 100, // sqlite3_step() has another row ready
    Done = 101, // sqlite3_step() has finished executing
}

export object SQLiteError {
    code: ResultCode,
    message: str? = "Error occured while interacting with SQLite database",
}

export enum<int> OpenFlag {
    Readonly = 0x00000001,
    ReadWrite = 0x00000002,
    Create = 0x00000004,
    DeleteOnClose = 0x00000008,
    Exclusive = 0x00000010,
    Autoproxy = 0x00000020,
    Uri = 0x00000040,
    Memory = 0x00000080,
    MainDb = 0x00000100,
    TempDb = 0x00000200,
    TransientDb = 0x00000400,
    MainJournal = 0x00000800,
    TempJournal = 0x00001000,
    SubJournal = 0x00002000,
    SuperJournal = 0x00004000,
    NoMutex = 0x00008000,
    FullMutex = 0x00010000,
    SharedCache = 0x00020000,
    PrivateCache = 0x00040000,
    Wal = 0x00080000,
    Nofollow = 0x01000000,
    ExResCode = 0x02000000,
}

enum<int> Type {
    Integer = 1,
    Float = 2,
    Text = 3,
    Blob = 4,
    Null = 5,
}

export object Query {
    query: str = "",

    fun branch(keyword: str, expression: str) => Query{
        query = "{this.query} {keyword.upper()} {expression}"
    };

    fun select(columns: [str]) => this.branch(
        "select",
        expression: columns.join(", ")
    );

    fun selectDistinct(columns: [str]) => this.branch(
        "select distinct",
        expression: columns.join(", ")
    );

    fun deleteFrom(expression: str) => this.branch(
        "delete from",
        expression: expression
    );

    fun insertInto(table: str, columns: [str]) => this.branch(
        "insert into",
        expression: "{table} ({columns.join(", ")})"
    );

    fun replaceInto(table: str, columns: [str]) => this.branch(
        "replace into",
        expression: "{table} ({columns.join(", ")})"
    );

    fun @"from"(tables: [str]) => this.branch(
        "from",
        expression: tables.join(", ")
    );

    fun where(conditions: [str]) > Query {
        if (conditions.len() == 0) {
            return this;
        }

        final where = mut Query{ query = "{this.query} WHERE " };

        foreach (i, condition in conditions) {
            where.query = "{where.query} {condition}";
            if (condition.len() > 1 and i < conditions.len() - 1) {
                where.query = "{where.query} AND";
            }
        }

        return where;
    }

    fun update(table: str) => this.branch("update", expression: table);

    fun set(columns: [str]) => this.branch(
        "set",
        expression: columns.join(", ")
    );

    fun like(column: str, expression: str) => Query{
        query = "{this.query} {column} LIKE {expression}",
    };

    fun orderBy(expression: str) => this.branch(
        "order by",
        expression: expression
    );

    fun groupBy(expression: str) => this.branch(
        "group by",
        expression: expression
    );

    fun values(values: [str]) => this.branch(
        "values",
        expression: "({values.join(", ")})"
    );

    fun limit(limit: int) => this.branch("limit", expression: "{limit}");

    fun prepare(db: Database) > Statement !> SQLiteError, errors\ReadWriteError => db
        .prepare(this);

    fun execute(
        db: Database
    ) > [[Boxed]] *> [Boxed]? !> SQLiteError, errors\ReadWriteError {
        final statement: Statement = db.prepare(this);

        return statement.execute();
    }
}

export object Statement {
    query: str,
    db: ud,
    stmt: ud,

    fun execute() > [[Boxed]] *> [Boxed]? !> SQLiteError {
        var code: ResultCode = .Ok;

        final rows: mut [[Boxed]] = mut [];
        while (code != .Done) {
            code = ResultCode(sqlite3_step(this.stmt)) ?? .Error;
            if (code != .Ok and code != .Row and code != .Done) {
                throw SQLiteError{
                    code = code,
                    message =
                        "Could not execute statement `{this.query}`: {code} {sqlite3_errmsg(this.db)}"
                };
            }

            if (code == .Done) {
                break;
            }

            final columnCount = sqlite3_column_count(this.stmt);
            final row: mut [any] = mut [];
            for (i: int = 0; i < columnCount; i = i + 1) {
                final columnType =
                    Type(sqlite3_column_type(this.stmt, col: i)) ?? .Null;

                if (columnType == .Integer) {
                    row.append(sqlite3_column_int(this.stmt, col: i));
                } else if (columnType == .Float) {
                    row.append(sqlite3_column_double(this.stmt, col: i));
                } else if (columnType == .Text) {
                    row.append(sqlite3_column_text(this.stmt, col: i));
                } else if (columnType == .Blob) {
                    row.append(sqlite3_column_blob(this.stmt, col: i));
                } else {
                    row.append(null);
                }
            }

            final boxedRow =
                (Boxed.init(row.cloneImmutable()) catch void).listValue();
            rows.append(boxedRow);

            _ = yield boxedRow;
        }

        return rows;
    }

    fun collect() > void {
        _ = sqlite3_finalize(this.stmt);
    }
}

export object Database {
    db: ud,

    fun collect() > void {
        _ = sqlite3_close_v2(this.db);
    }

    fun prepare(query: Query) !> SQLiteError, errors\ReadWriteError => this
        .prepareRaw(query.query);

    fun prepareRaw(query: str) > Statement !> SQLiteError, errors\ReadWriteError {
        final buffer = buffer\Buffer.init();
        buffer.writeUserData(std\toUd(0)) catch void;

        final code = ResultCode(sqlite3_prepare_v2(
            db: this.db,
            zSql: ffi\cstr(query),
            nBytes: -1,
            ppStmt: buffer.ptr(),
            pzTail: null,
        )) ?? .Error;
        if (code != .Ok) {
            throw SQLiteError{
                code = code,
                message =
                    "Could not prepareRaw query `{query}`: {code} {sqlite3_errmsg(this.db)}"
            };
        }

        return Statement{
            query = query,
            stmt = buffer.readUserData()!,
            db = this.db,
        };
    }
}

export object SQLite {
    static fun init() > SQLite !> SQLiteError {
        final code = ResultCode(sqlite3_initialize()) ?? .Error;
        if (code != .Ok) {
            throw SQLiteError{
                code = code,
                message = "Could not initialize SQLite: {code}"
            };
        }

        return SQLite{};
    }

    static fun escape(string: str) => sqlite3_mprintf(ffi\cstr(string)) ?? "";

    fun collect() > void {
        _ = sqlite3_shutdown();
    }

    fun open(
        filename: str,
        flags: [OpenFlag]
    ) > Database !> SQLiteError, errors\ReadWriteError {
        var cFlags = 0;
        foreach (flag in flags) {
            cFlags = cFlags | flag.value;
        }

        final buffer = buffer\Buffer.init();
        buffer.writeUserData(std\toUd(0)) catch void;

        final code = ResultCode(sqlite3_open_v2(
            filename: ffi\cstr(filename),
            ppDb: buffer.ptr(),
            flags: cFlags,
            zVfs: null
        )) ?? .Error;

        if (code != .Ok) {
            throw SQLiteError{
                code = code,
                message = "Could not open database `{filename}`: {code}"
            };
        }

        return Database{
            db = buffer.readUserData()!,
        };
    }
}

test "Testing sqlite" {
    final sqlite = SQLite.init();

    final database = sqlite.open("./test.db", flags: [ .ReadWrite, .Create ]);

    final statement = database.prepareRaw(`
        CREATE TABLE IF NOT EXISTS test (
            name TEXT NOT NULL
        )
    `);

    _ = statement.execute();

    foreach (name in [ "john", "joe", "janet", "joline" ]) {
        _ =
            Query{}.insertInto("test", columns: [ "name" ]).values(
                [ "'{name}'" ]
            ).execute(database);
    }

    final select =
        Query{}.select([ "rowid", "name" ]).@"from"([ "test" ]).prepare(
            database
        );

    foreach (row in &select.execute()) {
        std\print("{row?[0].integerValue()}: {row?[1].stringValue()}");
    }
}
