import "buzz:std";
import "buzz:errors";
import "buzz:io";
import "buzz:os";
import "pkg:shiplog/args" as _;
import "pkg:shiplog/journal" as _;
import "pkg:shiplog/sqlite" as _;
import "pkg:shiplog/log" as _;

fun getEntrySource(
    command: Command
) > str?
    !>
    SQLiteError,
    errors\ExecError,
    errors\FileSystemError,
    errors\ReadWriteError,
    errors\UnexpectedError {
    if (command.options["file"]?.value -> file) {
        return io\File.open(file, mode: .read).readAll();
    }

    if (command.arguments["entry"]?.value -> entry) {
        if (entry.len() > 0) {
            return entry.join(" ");
        }
    }

    if (!io\stdin.isTTY()) {
        return io\stdin.readAll();
    }

    final tmpFile = os\tmpFilename("shiplog");

    if (os\execute([ os\env("EDITOR") ?? "vi", tmpFile ]) == 0) {
        return io\File.open(tmpFile, mode: .read).readAll();
    }

    return null;
}

fun main(args: [str]) > void {
    final command = mut Command{
        name = "shiplog",
        desc = "\226\154\147 A journal keeping cli tool",
        options = {
            "help": mut .{
                name = "help",
                desc = "Show this help message",
                aliases = [ "h" ],
            },
            "directory": mut .{
                name = "directory",
                desc =
                    "Specify where shiplog will leave (default is ~/.shiplog)",
                aliases = [ "dir", "d" ],
            },
            "verbose": mut .{
                name = "verbose",
                desc = "Show debug logs",
                aliases = [ "v" ]
            },
        },
        commands = {
            "add": mut .{
                name = "add",
                desc = "Write a log entry",
                options = {
                    "file": mut .{
                        name = "file",
                        desc = "Use file content as entry",
                        aliases = [ "f" ],
                    },
                },
                arguments = {
                    "entry": mut .{
                        name = "entry",
                        desc =
                            "The entry. Any word prefixed by `+` will be added as a tag. If omitted will be read from stdin",
                        min = 0,
                        max = null,
                    },
                },
            },
            "list": mut .{
                name = "list",
                desc = "List log entries",
                arguments = {
                    "filter": mut .{
                        name = "filter",
                        desc =
                            "Filter entries. You can filter in or out tags by prefixing the tag name by `+` or `:` respectively.",
                        min = 0,
                        max = null,
                    },
                },
                options = {
                    "limit": mut .{
                        name = "limit",
                        desc = "Limit number of printed entries",
                        aliases = [ "n" ],
                        hasValue = true,
                    },
                    "before": mut .{
                        name = "before",
                        desc = "Only show entry created before this date",
                        aliases = [ "b" ],
                        hasValue = true,
                    },
                    "after": mut .{
                        name = "after",
                        desc = "Only show entry created after this date",
                        aliases = [ "a" ],
                        hasValue = true,
                    },
                    "at": mut .{
                        name = "at",
                        desc = "Only show entry created at this date",
                        hasValue = true,
                    },
                    "short": mut .{
                        name = "short",
                        desc = "Short list with only titles and IDs",
                        aliases = [ "s" ],
                    },
                },
            },
            "delete": mut .{
                name = "delete",
                desc = "Delete entry",
                aliases = [ "del", "d" ],
                arguments = {
                    "id": mut .{
                        name = "id",
                        desc = "Entry ID",
                        min = 1,
                        max = 1,
                    },
                },
            },
            "modify": mut .{
                name = "modify",
                desc = "Modify entry",
                aliases = [ "mod", "m" ],
                arguments = {
                    "id": mut .{
                        name = "id",
                        desc = "Entry ID",
                        min = 1,
                        max = 1,
                    },
                    "entry": mut .{
                        name = "entry",
                        desc =
                            "Any word prefixed by `+` will be added as a tag. Any word prefixed by `:` will be considered a tag to be deleted.",
                        min = 0,
                        max = null,
                    },
                },
            },
            "view": mut .{
                name = "view",
                desc = "View entry",
                aliases = [ "v" ],
                arguments = {
                    "id": mut .{
                        name = "id",
                        desc = "Entry ID",
                        min = 1,
                        max = 1,
                    },
                },
            },
        },
    };

    _ = command.parse(args);

    Logger.instance = Logger{
        into = io\stderr,
        level =
            if (command.options["verbose"]?.value != null) Level.Debug else Level
                .Error,
    };

    if (command.options["help"]?.value != null) {
        command.help();
        return;
    }

    try {
        final sqlite = SQLite.init();
        final journal = Journal.init(
            sqlite,
            path: command.options["directory"]?.value
        );

        final addCommand = command.commands["add"]!;
        if (addCommand.selected) {
            if (Entry.parse(getEntrySource(addCommand) ?? "") -> entry) {
                journal.addEntry(entry);
            } else {
                std\print("Could not parse entry");
            }

            return;
        }

        final modifyCommand = command.commands["modify"]!;
        if (modifyCommand.selected) {
            final entryId = modifyCommand.arguments["id"]?.value?[0] ?? "";
            var filter =
                Filter.parse(modifyCommand.arguments["entry"]?.value ?? [<str>]);
            final parsedEntryId = std\parseInt(entryId) ?? 0;
            filter.id = parsedEntryId;

            final entry = journal.getEntry(parsedEntryId);

            if (entry == null) {
                std\print("Entry #{filter.id} does not exists");
                return;
            }

            if (filter.isEmpty()) {
                final tmpFile = os\tmpFilename("shiplog");

                final file = io\File.open(tmpFile, mode: .write);
                file.write(entry?.expr() ?? "");
                file.close();

                if (os\execute([ os\env("EDITOR") ?? "vi", tmpFile ]) == 0) {
                    filter =
                        Filter.parse(
                            io\File.open(tmpFile, mode: .read).readAll().split(
                                " "
                            )
                        );
                    filter.id = parsedEntryId;
                }
            }

            journal.modifyEntry(filter);
        }

        final listCommand = command.commands["list"]!;
        if (listCommand.selected) {
            final filter =
                Filter.parse(listCommand.arguments["filter"]?.value ?? [<str>]);
            filter.before = listCommand.options["before"]?.value;
            filter.after = listCommand.options["after"]?.value;
            filter.at = listCommand.options["at"]?.value;
            if (listCommand.options["limit"]?.value -> limit) {
                filter.limit = std\parseInt(limit);
            }

            journal.listEntries(
                filter,
                short: listCommand.options["short"]?.value != null
            );

            return;
        }

        final deleteCommand = command.commands["delete"]!;
        if (deleteCommand.selected) {
            if (std\parseInt(deleteCommand.arguments["id"]!.value![0]) -> id) {
                journal.deleteEntry(id);
            } else {
                std\print("Entry ID must be integer");
            }

            return;
        }
    } catch (error: SQLiteError) {
        Logger.instance?.error("{error.code} {error.message}", scope: "SQL");
    } catch (error: any) {
        Logger.instance?.error("Something went wrong: {error}");
    }
}
