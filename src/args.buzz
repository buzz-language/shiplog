namespace shiplog\args;

import "buzz:std";
import stderr from "buzz:io";

export object Option {
    name: str,
    desc: str,
    aliases: [str] = [],
    hasValue: bool = false,
    value: str?,
}

export object Argument {
    name: str,
    desc: str,
    min: int = 1,
    max: int? = 1,
    value: [str]?,
    defaultValue: [str]?,
}

object ParseState {
    arg: int = 0,
    offset: int = 0,
    argParsed: bool = false,
    mandatoryArguments: [mut Argument] = [],
    args: [str],
}

object ParseError {
    message: str?,
}

export object Command {
    name: str,
    desc: str,
    selected: bool = false,
    aliases: [str] = [],
    options: {str: mut Option} = {},
    arguments: {str: mut Argument} = {},
    commands: {str: mut Command} = {},
    state: mut ParseState?,

    mut fun clear() > void {
        this.selected = false;
        this.state = null;

        foreach (option in this.options) {
            option.value = null;
        }

        foreach (argument in this.arguments) {
            argument.value = null;
        }

        foreach (command in this.commands) {
            command.clear();
        }
    }

    mut fun consumeOption() > void !> ParseError {
        std\assert(this.state != null, message: "No state");

        final current = this.state!.args[this.state!.offset];

        foreach (option in this.options) {
            if (current.startsWith("--")) {
                if (option.name != current.sub(2)) {
                    continue;
                }
            } else if (option.aliases.indexOf(current.sub(1)) != null) {
                // Matched an alias.
            } else {
                continue;
            }

            if (option.hasValue) {
                this.state!.offset += 1;
                option.value = this.state!.args[this.state!.offset];
            } else {
                option.value = "true";
            }

            this.state!.offset += 1;

            return;
        }

        throw ParseError{ message = "Option `{current}` does not exists" };
    }

    mut fun consumeArgument() > void !> ParseError {
        std\assert(this.state != null, message: "No state");

        final currentArg =
            if (this.arguments.size() > 0
                and this.state!.arg < this.arguments.size()) this.arguments[this
                .arguments.keys()[this.state!.arg]] else null;

        if (currentArg -> arg) {
            final value: mut [str] = mut [];
            for (i: int = 0; (arg.max == null or i < arg.max!)
                and this.state!.offset < this.state!.args.len(); i += 1) {
                value.append(this.state!.args[this.state!.offset]);
                this.state!.offset += 1;

                // Next is not an argument
                if ((this.state!.offset >= this.state!.args.len()
                    or this.state!.args[this.state!.offset].startsWith("-"))
                    and (arg.max == null or i + 1 < arg.max!)) {
                    if (i + 1 >= arg.min) {
                        break;
                    } else {
                        throw ParseError{
                            message =
                                "Argument `{arg.name}` expects at least {arg.min} elements, {i + 1} provided"
                        };
                    }
                }
            }

            arg.value = value.cloneImmutable();
        } else {
            return;
        }

        this.state!.arg += 1;

        // If we parsed all arguments or at least mandatory ones, set flag
        this.state!.argParsed =
            this.state!.arg >= this.arguments.size()
            or (this.state!.args[this.state!.offset].startsWith("-")
                and this.state!.arg >= this.state!.mandatoryArguments.len());
    }

    mut fun consumeCommand() > bool {
        final current =
            if (this.state != null) this.state!.args[this.state!.offset] else "";

        // Could it be a sub-command?
        foreach (command in this.commands) {
            if (current == command.name
                or command.aliases.indexOf(current) != null) {
                this.state!.offset += 1;
                command.state = this.state;
                final args = this.state?.args ?? [<str>];
                final offset = this.state?.offset ?? 0;
                _ =
                    command.parse(
                        if (offset < args.len()) args.sub(
                            this.state?.offset ?? 0
                        ) else [<str>]
                    );

                return true;
            }
        }

        return false;
    }

    mut fun parse(args: [str]) > mut Command {
        try {
            this.selected = true;

            final mandatoryArguments: mut [mut Argument] = mut [];
            foreach (arg in this.arguments) {
                if (arg.min > 0) {
                    mandatoryArguments.append(arg);
                }
            }

            final state = mut ParseState{
                args = args,
                mandatoryArguments = mandatoryArguments,
            };
            this.state = state;

            while (state.offset < args.len()) {
                final arg = args[state.offset];

                if (arg[0] == "-") {
                    // Did we parse required arguments before?
                    if (!state.argParsed and state.arg != 0
                        and this.arguments.size() > 0
                        and state.mandatoryArguments.len() > 0) {
                        throw ParseError{ message = "Missing arguments" };
                    }

                    // It's an option
                    this.consumeOption();
                } else {
                    // It's either an argument or a sub-command

                    // Is there some required arguments?
                    if (!state.argParsed and state.mandatoryArguments.len() > 0) {
                        this.consumeArgument();
                    } else if (!this.consumeCommand()) {
                        // It must be an argument
                        this.consumeArgument();
                    } else {
                        return this;
                    }
                }
            }
        } catch (error: ParseError) {
            this.error(error);
        }

        return this;
    }

    fun usage() > void {
        try {
            stderr.write("Usage: {this.name} ");

            foreach (option in this.options) {
                stderr.write("[--{option.name}");

                if (option.hasValue) {
                    stderr.write(" <{option.name}>");
                }

                stderr.write("] ");
            }

            foreach (argument in this.arguments) {
                if (argument.min == 0) {
                    stderr.write("[");
                }

                stderr.write("<{argument.name}");

                if (argument.min > 1 or argument.max == null
                    or argument.max! > 1) {
                    stderr.write(", ...");
                }

                stderr.write(">");

                if (argument.min == 0) {
                    if (argument.defaultValue -> value) {
                        stderr.write("={value.join(", ")}");
                    }
                    stderr.write("]");
                }

                stderr.write(" ");
            }

            if (this.commands.size() > 0) {
                stderr.write("<command> ...");
            }
        } catch {}
    }

    fun error(error: ParseError) {
        this.usage();

        stderr.write(
            "\n\nError: {error.message ?? "could not parse arguments"}\n\n"
        ) catch void;
    }

    fun help() > void {
        try {
            this.usage();

            stderr.write("\n\n{this.desc}");

            if (this.options.size() > 0) {
                stderr.write("\n\nOptions:\n");
                foreach (option in this.options) {
                    stderr.write("   --{option.name}");
                    foreach (alias in option.aliases) {
                        stderr.write(", -{alias}");
                    }
                    if (option.hasValue) {
                        stderr.write(" <{option.name}>");
                    }
                    stderr.write("\t{option.desc}\n");
                }
            }

            if (this.commands.size() > 0) {
                stderr.write("\nCommands:\n");
                foreach (command in this.commands) {
                    stderr.write("   {command.name}");
                    foreach (alias in command.aliases) {
                        stderr.write(", {alias}");
                    }
                    stderr.write("\t {command.desc}\n");
                }
            }
        } catch {}
    }
}

test "bargz" {
    final args = "one two three --option 12 -d on list --help".split(" ");

    final command = mut Command{
        name = "test",
        desc = "Test things out",
        arguments = {
            "first": mut .{
                name = "first",
                desc = "First ones",
                min = 1,
                max = 2,
            },
            "second": mut .{
                name = "second",
                desc = "Second ones",
            },
        },
        options = {
            "option": mut .{
                name = "option",
                desc = "Option is optional",
                hasValue = true,
            },
            "debug": mut .{
                name = "debug",
                desc = "Debug things",
                aliases = [ "d" ],
                hasValue = true,
            },
            "help": mut .{
                name = "help",
                desc = "Show this help message",
                aliases = [ "h" ],
            },
        },
        commands = {
            "list": mut .{
                name = "list",
                desc = "List things",
                arguments = {
                    "dir": mut .{
                        name = "dir",
                        desc = "Which directory to list",
                    },
                },
                options = {
                    "help": mut .{
                        name = "help",
                        desc = "Show this help message",
                        aliases = [ "h" ],
                    },
                },
            },
        },
    };

    _ = command.parse(args);

    if (command.options["help"]?.value != null) {
        command.help();
        return;
    }

    final listCommand = command.commands["list"]!;
    if (listCommand.selected and listCommand.options["help"]?.value != null) {
        listCommand.help();
        return;
    }
}
