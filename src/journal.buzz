namespace shiplog\journal;

import "buzz:std";
import "buzz:fs";
import "buzz:os";
import "buzz:errors";
import "buzz:serialize" as _;
import "pkg:shiplog/sqlite" as _;
import "pkg:shiplog/term";

export object Attribute {
    id: int?,
    name: str,
    @"type": str,

    static fun createTables(
        db: Database
    ) > void !> SQLiteError, errors\ReadWriteError {
        // FIXME: calling with resolve should free surrounding function to require yield type
        _ = resolve &(db.prepareRaw(`
            CREATE TABLE IF NOT EXISTS attributes (
                rowid INTEGER NOT NULL PRIMARY KEY,
                name TEXT NOT NULL UNIQUE,
                type TEXT NOT NULL
            )
        `)).execute();

        _ = resolve &(db.prepareRaw(`
            CREATE TABLE IF NOT EXISTS entries_attributes (
                entry_id INTEGER NOT NULL, 
                attribute_id INTEGER NOT NULL,
                value TEXT NOT NULL,
                FOREIGN KEY(entry_id) REFERENCES entries(rowid),
                FOREIGN KEY(attribute_id) REFERENCES attributes(rowid),
                PRIMARY KEY(entry_id, attribute_id)
            )
        `)).execute();
    }
}

export object Tag {
    id: int?,
    label: str,

    static fun fromBoxed(propertyList: [Boxed]) => Tag{
        id = propertyList[0].integerValue(),
        label = propertyList[1].stringValue(),
    };

    static fun createTables(
        db: Database
    ) > void !> SQLiteError, errors\ReadWriteError {
        _ = resolve &(db.prepareRaw(`
            CREATE TABLE IF NOT EXISTS entries_tags (
                entry_id INTEGER NOT NULL, 
                tag TEXT NOT NULL,
                FOREIGN KEY(entry_id) REFERENCES entries(rowid),
                PRIMARY KEY(entry_id, tag)
            )
        `)).execute();
    }

    fun colored() > str {
        final a = std\toDouble("a".byte(0));

        final r =
            ((std\toDouble(this.label.lower().byte(0)) - a) / 26.0) * 255.0;
        final g =
            ((std\toDouble(this.label.lower().byte(1)) - a) / 26.0) * 255.0;
        final b =
            ((std\toDouble(this.label.lower().byte(2)) - a) / 26.0) * 255.0;

        return "+\027[38;2;{std\toInt(r)};{std\toInt(g)};{std\toInt(b)}m{this.label}\027[0m";
    }
}

export object Entry {
    id: int?,
    createdAt: str?,
    updatedAt: str?,
    content: str,
    location: str?,
    tags: mut [Tag],
    attributes: mut {str: str},

    static fun fromBoxed(propertyList: [Boxed]) => mut Entry{
        id = propertyList[0].integerValue(),
        createdAt = propertyList[1].stringValue(),
        updatedAt = propertyList[2].string(),
        content = propertyList[3].stringValue(),
        location = propertyList[4].string(),
        tags = mut [],
        attributes = mut {},
    };

    static fun createTables(
        db: Database
    ) > void !> SQLiteError, errors\ReadWriteError {
        _ = resolve &(db.prepareRaw(`
            CREATE TABLE IF NOT EXISTS entries (
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,
                updated_at TIMESTAMP,
                content TEXT NOT NULL,
                location TEXT
            )
        `)).execute();
    }

    static fun parse(args: str) > mut Entry? {
        final tags: mut [str] = mut [];
        final attributes: mut {str: str} = mut {};
        var content = "";

        foreach (line in args.split("\n")) {
            foreach (word in line.split(" ")) {
                final trimmed = word.trim();
                final prefix = trimmed[0];

                if (prefix == "+") {
                    tags.append(trimmed.sub(1));
                } else if ($"^([^=])+=([^\s]+)".matchAgainst(trimmed) -> m) {
                    attributes[m[1].capture] = m[2].capture;
                } else {
                    content = "{content}{word} ";
                }
            }

            content += "\n";
        }

        content = content.trim();

        return mut Entry{
            content,
            tags =
                tags.map::<Tag>(fun (_: int, tag: str) => Tag{ label = tag })
                    .cloneMutable(),
            attributes = attributes,
        };
    }

    fun expr() > str {
        var expression = "";
        foreach (key, value in this.attributes) {
            expression = "{expression}{key}={value}\n";
        }

        foreach (tag in this.tags) {
            expression = "{expression}+{tag.label}\n";
        }

        return "{expression}{this.content}";
    }
}

export object Filter {
    id: int?,
    tags: mut [str],
    excludedTags: mut [str],
    attributes: mut {str: str},
    excludedAttributes: mut {str: str},
    content: str?,
    before: str?,
    after: str?,
    at: str?,
    limit: int?,

    fun isEmpty() > bool {
        return this.tags.len() == 0 and this.excludedTags.len() == 0
            and this.attributes.size() == 0
            and this.excludedAttributes.size() == 0 and this.content == null;
    }

    static fun parse(args: [str]) > mut Filter {
        final filter = mut Filter{
            tags = mut [],
            excludedTags = mut [],
            attributes = mut {},
            excludedAttributes = mut {},
        };

        foreach (word in args) {
            final trimmed = word.trim();
            final prefix = trimmed[0];

            if (prefix == "+") {
                filter.tags.append(trimmed.sub(1));
            } else if (prefix == ":") {
                filter.excludedTags.append(trimmed.sub(1));
            } else if ($"^([^=])+=([^\s]+)".matchAgainst(trimmed) -> m) {
                filter.attributes[m[1].capture] = m[2].capture;
            } else {
                filter.content = "{filter.content ?? ""}{word} ";
            }

            // TODO: excluded attributes
        }

        filter.content = filter.content?.trim();

        return filter;
    }
}

export object Journal {
    db: Database,

    static fun init(
        sqlite: SQLite,
        path: str?
    ) > Journal
        !>
        SQLiteError,
        errors\FileSystemError,
        errors\ReadWriteError,
        errors\UnexpectedError {
        final dir = path ?? "{os\env("HOME")}/.shiplog";
        final initialized = fs\exists("{dir}/journal.db");

        if (!initialized) {
            try {
                fs\makeDirectory(dir);
            } catch (err: errors\FileSystemError) {
                if (err != .PathAlreadyExists) {
                    throw err;
                }
            }
        }

        final db = sqlite.open(
            "{dir}/journal.db",
            flags: [ .ReadWrite, .Create ],
        );

        if (!initialized) {
            Entry.createTables(db);
            Tag.createTables(db);
            Attribute.createTables(db);
        }

        return Journal{ db };
    }

    fun getEntry(id: int) > Entry? !> SQLiteError, errors\ReadWriteError {
        final result = resolve &Query{}.select(
            [ "rowid", "created_at", "updated_at", "content", "location" ]
        ).@"from"([ "entries" ]).where([ "rowid = {id}" ]).execute(this.db);

        if (result.len() == 0) {
            return null;
        }

        final entry = Entry.fromBoxed(result[0]);

        final selectTags =
            Query{}.select([ "rowid", "tag" ]).@"from"([ "entries_tags " ])
                .where([ "entry_id = {entry.id}" ]).prepare(this.db);

        foreach (tagRow in &selectTags.execute()) {
            if (tagRow -> row) {
                entry.tags.append(Tag.fromBoxed(row));
            }
        }

        return entry;
    }

    fun getEntries(
        filter: Filter
    ) > [Entry] *> Entry? !> SQLiteError, errors\ReadWriteError {
        final entries: mut [Entry] = mut [];
        var selectEntriesQuery = Query{}.select(
            [ "rowid", "created_at", "updated_at", "content", "location" ]
        ).@"from"([ "entries" ]);

        final conditions: mut [str] = mut [];

        if (filter.content -> content) {
            conditions.append("content LIKE '%{content}%'");
        }

        if (filter.id -> id) {
            conditions.append("rowid = {id}");
        }

        if (filter.tags.len() > 0) {
            final tagFilter =
                filter.tags.map::<str>(fun (_: int, tag: str) => "'{tag}'").join(
                    ", "
                );
            conditions.append(
                "rowid IN (SELECT entry_id FROM entries_tags WHERE tag IN ({tagFilter}))"
            );
        }

        if (filter.excludedTags.len() > 0) {
            final tagFilter = filter.excludedTags.map::<str>(
                fun (_: int, tag: str) => "'{tag}'"
            ).join(", ");
            conditions.append(
                "rowid NOT IN (SELECT entry_id FROM entries_tags WHERE tag IN ({tagFilter}))"
            );
        }

        if (filter.before -> before) {
            conditions.append("date(created_at) < date('{before}')");
        }

        if (filter.after -> after) {
            conditions.append("date(created_at) > date('{after}')");
        }

        if (filter.at -> at) {
            conditions.append("date(created_at) = date('{at}')");
        }

        selectEntriesQuery = selectEntriesQuery.where(conditions);

        if (filter.limit -> limit) {
            selectEntriesQuery = selectEntriesQuery.limit(limit);
        }

        foreach (entryRow in &selectEntriesQuery.execute(this.db)) {
            if (entryRow == null) {
                continue;
            }

            final entry = Entry.fromBoxed(entryRow!);
            final selectTags =
                Query{}.select([ "rowid", "tag" ]).@"from"([ "entries_tags " ])
                    .where([ "entry_id = {entry.id}" ]).prepare(this.db);

            foreach (tagRow in &selectTags.execute()) {
                if (tagRow -> row) {
                    entry.tags.append(Tag.fromBoxed(row));
                }
            }

            entries.append(entry);
            _ = yield entry;
        }

        return entries;
    }

    fun listEntries(
        filter: Filter,
        short: bool = false
    ) > void !> SQLiteError, errors\ReadWriteError {
        foreach (entryOrNull in &this.getEntries(filter)) {
            if (entryOrNull == null) {
                continue;
            }

            final entry = entryOrNull!;
            var line = entry.content;
            if ($"([^\n]+)".matchAgainst(entry.content) -> m) {
                line = m[1].capture;
            }
            line = line.sub(0, len: 80);

            final tags: mut [str] = mut [];
            foreach (tag in entry.tags) {
                tags.append(tag.colored());
            }

            if (short) {
                std\print(term\cyan("#{entry.id} ") + term\green(line) + " "
                    + tags.join(" "));
            } else {
                std\print(
                    term\cyan("#{entry.id} ") + term\green(line) + "\n"
                        + term\dim(entry.updatedAt ?? entry.createdAt ?? "")
                        + " " + tags.join(" ")
                );
            }
        }
    }

    fun addEntry(entry: mut Entry) > void !> SQLiteError, errors\ReadWriteError {
        _ =
            resolve &Query{}.insertInto("entries", columns: [ "content" ])
                .values([ "'{entry.content}'" ]).execute(this.db);

        entry.id =
            (resolve &Query{}.select([ "LAST_INSERT_ROWID()" ]).execute(this.db))[0][0]
                .integerValue();

        foreach (tag in entry.tags) {
            _ = resolve &Query{}.insertInto(
                "entries_tags",
                columns: [ "entry_id", "tag" ]
            ).values([ "{entry.id}", "'{tag.label}'" ]).execute(this.db);
        }
    }

    fun modifyEntry(filter: Filter) > void !> SQLiteError, errors\ReadWriteError {
        if (filter.id == null) {
            return;
        }

        if (filter.content -> content) {
            _ =
                resolve &Query{}.update("entries").set(
                    [ "content = '{content}'" ]
                ).where([ "rowid = {filter.id}" ]).execute(this.db);
        }

        foreach (tag in filter.tags) {
            _ = resolve &Query{}.replaceInto(
                "entries_tags",
                columns: [ "entry_id", "tags" ]
            ).values([ "{filter.id}", "'{tag}'" ]).where(
                [ "entry_id = {filter.id}" ]
            ).execute(this.db);
        }

        if (filter.excludedTags.len() > 0) {
            final tags = filter.excludedTags.map::<str>(
                fun (_: int, tag: str) => "'{tag}'",
            ).join(", ");

            _ = resolve &Query{}.deleteFrom("entries_tags").where(
                [ "entry_id = {filter.id}", "tag IN ({tags})" ]
            ).execute(this.db);
        }

        // TODO: attributes
    }

    fun deleteEntry(id: int) > void !> SQLiteError, errors\ReadWriteError {
        _ =
            resolve &Query{}.deleteFrom("entries").where([ "rowid = {id}" ])
                .execute(this.db);

        _ =
            resolve &Query{}.deleteFrom("entries_tags").where(
                [ "entry_id = {id}" ]
            ).execute(this.db);
    }
}
