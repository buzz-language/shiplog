namespace shiplog\term;

import "buzz:std";

export enum<int> Color {
    // attributes
    reset      = 0,
    bright     = 1,
    dim        = 2,
    underscore = 4,
    blink      = 5,
    reverse    = 7,
    hidden     = 8,

    // foreground
    black   = 30,
    red     = 31,
    green   = 32,
    yellow  = 33,
    blue    = 34,
    magenta = 35,
    cyan    = 36,
    white   = 37,

    // background
    onblack   = 40,
    onred     = 41,
    ongreen   = 42,
    onyellow  = 43,
    onblue    = 44,
    onmagenta = 45,
    oncyan    = 46,
    onwhite   = 47,
}

export fun color(text: str, color: Color, reset: bool = true) => "\27[{color.value}m{text}{if (reset) "\27[0m" else ""}";

export fun bright(text: str) => color(text, color: .bright);
export fun dim(text: str) => color(text, color: .dim);
export fun underscore(text: str) => color(text, color: .underscore);
export fun blink(text: str) => color(text, color: .blink);
export fun reverse(text: str) => color(text, color: .reverse);
export fun hidden(text: str) => color(text, color: .hidden);
export fun black(text: str) => color(text, color: .black);
export fun red(text: str) => color(text, color: .red);
export fun green(text: str) => color(text, color: .green);
export fun yellow(text: str) => color(text, color: .yellow);
export fun blue(text: str) => color(text, color: .blue);
export fun magenta(text: str) => color(text, color: .magenta);
export fun cyan(text: str) => color(text, color: .cyan);
export fun white(text: str) => color(text, color: .white);
export fun onblack(text: str) => color(text, color: .onblack);
export fun onred(text: str) => color(text, color: .onred);
export fun ongreen(text: str) => color(text, color: .ongreen);
export fun onyellow(text: str) => color(text, color: .onyellow);
export fun onblue(text: str) => color(text, color: .onblue);
export fun onmagenta(text: str) => color(text, color: .onmagenta);
export fun oncyan(text: str) => color(text, color: .oncyan);
export fun onwhite(text: str) => color(text, color: .onwhite);

test "color" {
    std\print(color("hello world", color: Color.red));
    std\print(color("hello world", color: Color.blue));
    std\print(dim(blue("hello world") + yellow(" bye you")));
}
